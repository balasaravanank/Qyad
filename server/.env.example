# Qyad. Copy to .env. Never commit .env or paste secrets in chat.
DATABASE_URL=sqlite:///./workspace.db
APP_ENV=development
AUTH_MODE=local
ALLOWED_HOSTS=localhost,127.0.0.1
# Production: APP_ENV=production, exact hostname(s), and full HTTPS PUBLIC_URL.
PUBLIC_URL=
# Optional Clerk. Leave all blank to use the original password login.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER_URL=
CLERK_AUTHORIZED_PARTIES=
